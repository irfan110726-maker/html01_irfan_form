<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio Pribadi</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #263238;
            line-height: 1.6;
        }

        header {
            background: #102a43;
            color: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        header h2 {
            color: #38bdf8;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 18px;
            font-size: 14px;
        }

        nav a:hover {
            color: #38bdf8;
        }

        .hero {
            min-height: 350px;
            padding: 80px 8%;
            background: linear-gradient(135deg, #102a43, #2563eb);
            color: white;
            text-align: center;
        }

        .hero h1 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .hero span {
            color: #38bdf8;
        }

        .hero p {
            max-width: 600px;
            margin: 0 auto 25px;
        }

        .button {
            display: inline-block;
            background: #38bdf8;
            color: #102a43;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
        }

        .button:hover {
            background: white;
            transform: translateY(-2px);
        }

        section {
            padding: 55px 8%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 30px;
            font-size: 28px;
            color: #102a43;
        }

        .about {
            max-width: 800px;
            margin: auto;
            text-align: center;
        }

        .skills {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .skill {
            background: white;
            padding: 18px 25px;
            border-radius: 10px;
            box-shadow: 0 4px 12px #00000010;
            border-bottom: 3px solid #38bdf8;
        }

        .projects {
            display: grid;
            grid-template-columns: repeat(
                auto-fit, minmax(220px, 1fr)
            );
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px #00000010;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px #00000020;
        }

        .card h3 {
            color: #2563eb;
            margin-bottom: 10px;
        }

        .contact {
            text-align: center;
            background: #e5eef8;
        }

        footer {
            background: #102a43;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 12px;
            }

            nav a {
                margin: 0 5px;
            }

            .hero h1 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h2>MyPortfolio</h2>

        <nav>
            <a href="#beranda">Beranda</a>
            <a href="#tentang">Tentang</a>
            <a href="#skill">Skill</a>
            <a href="#proyek">Proyek</a>
            <a href="#kontak">Kontak</a>
        </nav>
    </header>

    <div class="hero" id="beranda">
        <h1>Halo, Saya <span>Irfan </span></h1>

        <p>
            Selamat datang di website portofolio saya.
            Saya sedang belajar matematika dan pemrograman web
            menggunakan HTML dan CSS.
        </p>

        <a href="#tentang" class="button">
            Kenali Saya
        </a>
    </div>

    <section id="tentang">
        <h2 class="section-title">Tentang Saya</h2>

        <div class="about">
            <p>
                Saya adalah mahasiswa yang tertarik pada
                teknologi, matematika, dan pengembangan website.
                Website ini merupakan salah satu contoh
                penerapan HTML dan CSS dalam membuat
                halaman web yang menarik dan responsif.
            </p>
        </div>
    </section>

    <section id="skill">
        <h2 class="section-title">Keterampilan</h2>

        <div class="skills">
            <div class="skill">HTML5</div>
            <div class="skill">CSS3</div>
            <div class="skill">Matematika</div>
            <div class="skill">Python Dasar</div>
        </div>
    </section>

    <section id="proyek">
        <h2 class="section-title">Proyek Saya</h2>

        <div class="projects">
            <div class="card">
                <h3>Proyek 1</h3>
                <p>
                    Membuat halaman web sederhana
                    menggunakan HTML.
                </p>
            </div>

            <div class="card">
                <h3>Proyek 2</h3>
                <p>
                    Mendesain website menggunakan CSS
                    agar tampil lebih modern.
                </p>
            </div>

            <div class="card">
                <h3>Proyek 3</h3>
                <p>
                    Membuat program matematika sederhana
                    menggunakan Python.
                </p>
            </div>
        </div>
    </section>

    <section id="kontak" class="contact">
        <h2 class="section-title">Hubungi Saya</h2>

        <p>Email: irfan110726@gmail.com</p>
        <p>Instagram: @fans_110726</p>
    </section>

    <footer>
        <p>&copy; 2026 MyPortfolio | Dibuat dengan HTML & CSS</p>
    </footer>

</body>
</html>
